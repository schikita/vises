{
  "name": "vises",
  "version": "0.1.0",
  "private": true,
  "description": "Vises monorepo (root Turborepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:api": "npm run start:dev -w @vises/api",
    "dev:worker": "npm run start:dev -w @vises/workflow-worker",
    "dev:web": "npm run dev -w @vises/web"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@12.0.2"
}
