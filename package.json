{
  "name": "vises",
  "version": "0.1.0",
  "private": true,
  "description": "Vises monorepo (root Turborepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:api": "pnpm run start:dev -w @vises/api",
    "dev:worker": "pnpm run start:dev -w @vises/workflow-worker",
    "dev:web": "pnpm run dev -w @vises/web"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
