{
  "name": "@vises/api",
  "version": "0.1.0",
  "private": true,
  "description": "Vises NestJS business API (CRM / staff HTTP)",
  "scripts": {
    "build": "nest build",
    "lint": "node -e \"process.exit(0)\"",
    "start": "nest start",
    "start:dev": "dotenv run -f .env.dev.local -- nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "typeorm": "dotenv run -f .env.dev.local -- typeorm",
    "migration:generate": "nest build && dotenv run -f .env.dev.local -- typeorm migration:generate ./src/modules/database/migrations/Migration -d ./dist/modules/database/typeorm.datasource.js",
    "migration:run": "nest build && dotenv run -f .env.dev.local -- typeorm migration:run -d ./dist/modules/database/typeorm.datasource.js",
    "migration:run:fake": "nest build && dotenv run -f .env.dev.local -- typeorm migration:run -d ./dist/modules/database/typeorm.datasource.js --fake"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/axios": "12.0.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "12.0.2",
    "@types/amqplib": "0.10.8",
    "@vises/config": "workspace:*",
    "@vises/contracts": "workspace:*",
    "@vises/database": "workspace:*",
    "@vises/domain-bls": "workspace:*",
    "amqplib": "2.2.0",
    "axios": "1.21.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "jsonwebtoken": "9.0.3",
    "logform": "^2.7.0",
    "multer": "^2.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "dotenv-cli": "^11.0.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@nestjs/core": "12.3.2",
    "@nestjs/common": "12.3.2"
  }
}
