# Dev env sample (never commit secrets).
# Copy: apps/api/.env.dev.example в†’ apps/api/.env.dev
# Host Nest: apps/api/.env.dev.local.example в†’ .env.dev.local

NODE_ENV=dev

POSTGRES_USER=vises
POSTGRES_PASSWORD=vises
POSTGRES_DB=vises

DATABASE_URL=postgresql://vises:vises@db:5432/vises

JWT_SECRET=vises-local-dev-only
DEMO_AUTH_ENABLED=true
UPLOAD_DIR=/uploads

VISES_PORTAL_BASE_URL=https://appointment.blsspainbelarus.by/
VISES_PORTAL_REGISTER_PATH=/Global/Account/RegisterUser
VISES_PORTAL_LOGIN_PATH=/Global/account/login
CAPMONSTER_API_KEY=

# Near-term: Proxy6 off (DEC-016). Leave empty.
PROXY6_API_KEY=


# DEC-016 fixture defaults for local/dev

# RabbitMQ (NFR-008 fail-closed when empty at MessagingModule init)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

VISES_SECRETS_MASTER_KEY=

LOG_DIR=/logs
