# Dev env sample (never commit secrets).
# Copy: apps/api/.env.dev.example в†’ apps/api/.env.dev
# Host Nest: apps/api/.env.dev.local.example в†’ .env.dev.local

NODE_ENV=dev

POSTGRES_USER=vises
POSTGRES_PASSWORD=vises
POSTGRES_DB=vises

DATABASE_URL=postgresql://vises:vises@db:5432/vises

JWT_SECRET=vises-local-dev-only
DEMO_AUTH_ENABLED=true
UPLOAD_DIR=/uploads

VISES_PORTAL_BASE_URL=https://appointment.blsspainbelarus.by/
VISES_PORTAL_REGISTER_PATH=/Global/Account/RegisterUser
VISES_PORTAL_LOGIN_PATH=/Global/account/login
CAPMONSTER_API_KEY=

# Near-term: Proxy6 off (DEC-016). Leave empty.
PROXY6_API_KEY=


# DEC-016 fixture defaults for local/dev

# RabbitMQ (NFR-008 fail-closed when empty at MessagingModule init)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

VISES_SECRETS_MASTER_KEY=

# Passport PII AES-256-GCM (FR-6 / AC-9). 64 hex chars (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty ⇒ boot OK; encrypt/decrypt fail-closed (503). Never commit a real key.
# Risk R-1: key is NOT rotatable in v1 — changing it without re-encrypt loses ciphertext.
VISES_PII_ENCRYPTION_KEY=

# Months after which modules/pii retention nulls FR-6 encrypted Client columns (AC-11).
PII_RETENTION_MONTHS=36

# Visa center monitor static API key (FR-7.4 / AC-13). Send as header:
#   X-Visa-Center-Monitor-Key: <value>
# Empty ⇒ boot OK; monitor endpoint fail-closed (401). Never commit a real key.
VISES_VISA_CENTER_MONITOR_API_KEY=

# Demo seed credentials (FR-11 / AC-19). Written only into an empty DB or via
# admin/superadmin reset-demo. Not production secrets — local/demo passwords.
#   superadmin  login=superadmin@vises.app  password=VisesAdmin1
#   admin       login=admin1@vises.app | admin2@vises.app  password=VisesAdmin1
#   agent A/B   login=agent-a@vises.app | agent-b@vises.app  password=VisesOffice1
# price_per_client (settings.default_price) seeded as 180.

LOG_DIR=/logs
