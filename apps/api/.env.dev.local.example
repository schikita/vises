# Host Nest overrides (apps/api). Copy в†’ .env.dev.local
DATABASE_URL=postgresql://vises:vises@127.0.0.1:5432/vises
UPLOAD_DIR=./uploads
LOG_DIR=./logs
JWT_SECRET=vises-local-dev-only
DEMO_AUTH_ENABLED=true

VISES_PORTAL_BASE_URL=https://appointment.blsspainbelarus.by
VISES_PORTAL_REGISTER_PATH=/Global/Account/RegisterUser
VISES_PORTAL_LOGIN_PATH=/Global/account/login
CAPMONSTER_API_KEY=
PROXY6_API_KEY=



RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

VISES_SECRETS_MASTER_KEY=

# Passport PII AES-256-GCM (FR-6). 64 hex chars. Never commit a real key. Not rotatable in v1 (R-1).
VISES_PII_ENCRYPTION_KEY=
PII_RETENTION_MONTHS=36

# Visa center monitor (FR-7.4). Header: X-Visa-Center-Monitor-Key. Never commit a real key.
VISES_VISA_CENTER_MONITOR_API_KEY=

# Demo seed credentials (FR-11 / AC-19). Empty-DB / reset-demo only — not prod secrets.
#   superadmin@vises.app / VisesAdmin1
#   admin1@vises.app | admin2@vises.app / VisesAdmin1
#   agent-a@vises.app | agent-b@vises.app / VisesOffice1
# price_per_client seeded as 180.
