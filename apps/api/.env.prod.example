# Prod env sample (never commit secrets).
# Copy before prod compose:
#   copy apps\api\.env.prod.example apps\api\.env.prod   (Windows)
#   cp apps/api/.env.prod.example apps/api/.env.prod     (Unix)
#
# Compose: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Replace every change-me value and fill empty secrets before deploy.
# Keep POSTGRES_PASSWORD and DATABASE_URL passwords identical.
# Keep RABBITMQ_DEFAULT_* and RABBITMQ_URL credentials identical.
# Browser/worker: NODE_ENV=prod → headless.

NODE_ENV=prod

POSTGRES_USER=vises
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=vises

DATABASE_URL=postgresql://vises:change-me-strong-db-password@db:5432/vises

# RabbitMQ image reads RABBITMQ_DEFAULT_*; apps use RABBITMQ_URL (NFR-008 fail-closed).
RABBITMQ_DEFAULT_USER=vises
RABBITMQ_DEFAULT_PASS=change-me-strong-rabbitmq-password
RABBITMQ_URL=amqp://vises:change-me-strong-rabbitmq-password@rabbitmq:5672

JWT_SECRET=change-me-to-a-long-random-secret
DEMO_AUTH_ENABLED=false
# Compose prod: named volume → /uploads
UPLOAD_DIR=/uploads

VISES_PORTAL_BASE_URL=https://appointment.blsspainbelarus.by
VISES_PORTAL_REGISTER_PATH=/Global/Account/RegisterUser
VISES_PORTAL_LOGIN_PATH=/Global/account/login
CAPMONSTER_API_KEY=

# Non-empty key enables DB-backed proxy leasing; empty → direct.
# Buy period/country are request-body only (not env).
PROXY6_API_KEY=

# Durable BLS workflow secrets (DEC-005): base64 of exactly 32 random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Empty → boot OK; encrypt/decrypt fail-closed (503). Never commit a real key.
# Backup this key — lost key = unrecovered vault ciphertext (RISK-004).
VISES_SECRETS_MASTER_KEY=

# Passport PII AES-256-GCM (FR-6 / AC-9). Exactly 64 hex characters (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty → boot OK; encrypt/decrypt fail-closed (503). Never commit a real key.
# Risk R-1: NOT rotatable in v1 — lost/changed key = unrecovered client passport ciphertext.
VISES_PII_ENCRYPTION_KEY=

# Months after which modules/pii retention nulls FR-6 encrypted Client columns (keep row).
PII_RETENTION_MONTHS=36

# Visa center monitor static API key (FR-7.4 / AC-13).
# Send as header: X-Visa-Center-Monitor-Key: <value>
# Empty → boot OK; monitor endpoint fail-closed (401). Never commit a real key.
VISES_VISA_CENTER_MONITOR_API_KEY=

# Demo seed credentials (FR-11) exist only for non-prod empty-DB / reset-demo.
# Do not rely on seed accounts in production (DEMO_AUTH_ENABLED=false).

# Durable Nest/Winston API logs root. Level folders + month/day files:
#   {LOG_DIR}/common/{YYYY-MM}/{YYYY-MM-DD}.log
#   {LOG_DIR}/error|warn|info/{YYYY-MM}/{YYYY-MM-DD}.log
# Dir must be writable; created at boot or fails.
# Compose prod: named volume → /logs
LOG_DIR=/logs
