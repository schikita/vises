# Dev env sample for workflow-worker (never commit secrets).
# Copy: apps/workflow-worker/.env.dev.example в†’ apps/workflow-worker/.env.dev
# Host: install Chrome via `npx patchright install` in apps/workflow-worker.

NODE_ENV=dev

POSTGRES_USER=vises
POSTGRES_PASSWORD=vises
POSTGRES_DB=vises

DATABASE_URL=postgresql://vises:vises@db:5432/vises

JWT_SECRET=vises-local-dev-only
DEMO_AUTH_ENABLED=true
UPLOAD_DIR=/uploads

VISES_PORTAL_BASE_URL=https://appointment.blsspainbelarus.by/
VISES_PORTAL_REGISTER_PATH=/Global/Account/RegisterUser
VISES_PORTAL_LOGIN_PATH=/Global/account/login
CAPMONSTER_API_KEY=

# Near-term: leave empty — Proxy6 leasing forced off (DEC-016 / CON-011).
PROXY6_API_KEY=



# DEC-004 / REQ-006: max concurrent attempts per worker (session budget = 2Г—).
VISES_PORTAL_MAX_ATTEMPTS_PER_WORKER=1

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

VISES_SECRETS_MASTER_KEY=

LOG_DIR=/logs
WORKER_PORT=8101

# Browserless (HTTP) engine portal proxy — evomi residential template.
# Format: http://USER:PASS_country-BY_fraudScore-0_session-{SESSION}_lifetime-30m@core-residential.evomi.com:1000
# {SESSION} is rotated automatically on 429 (sticky per session). Requires your own
# evomi account (this branch uses evomi, NOT proxy6 — see modules/portal-http/README.md).
PORTAL_HTTP_PROXY_TEMPLATE=
# Pacing between portal requests for the HTTP engine (ms)
PORTAL_HTTP_PACING_MS=9000
